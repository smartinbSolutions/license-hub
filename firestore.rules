rules_version = '2';

// Firestore security rules outline for POS License Manager.
// All writes must go through admin Cloud Functions. The client
// dashboard is read-only for admin-claimed users.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Licenses: admins read; only Cloud Functions write.
    match /licenses/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Plans: admins read; only Cloud Functions write.
    match /plans/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Audit logs: admins read; written only by Cloud Functions.
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Activation attempts: admins read; written only by activateLicense.
    match /activationAttempts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
